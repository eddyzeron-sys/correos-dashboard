# Copia este archivo a .env y llena los valores. Nunca subas .env a git.

# Puerto donde corre la app
PORT=3000

# Usuario/contraseña del admin de la app (solo se usan la PRIMERA vez que arranca,
# para crear el usuario admin en la base de datos local)
ADMIN_USER=admin
ADMIN_PASS=cambia-esto-por-una-contrasena-fuerte

# Secreto para firmar las cookies de sesión (cualquier cadena larga y aleatoria)
SESSION_SECRET=genera-una-cadena-aleatoria-larga

# Clave de cifrado para las contraseñas guardadas (cPanel y buzones).
# Debe ser un string de 32 bytes en hex (64 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
