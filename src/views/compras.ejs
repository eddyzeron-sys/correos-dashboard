<!DOCTYPE html>
<html lang="es">
<head>
  <title>Compras</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="shell-wrap">
    <div class="app-shell">
      <%- include('partials/sidebar', { activeNav: 'compras' }) %>
      <main class="app-main">
        <header class="topbar">
          <div></div>
          <div class="header-actions"></div>
        </header>

        <% if (error) { %>
          <p class="error"><%= error %></p>
        <% } %>

        <div class="compras-layout">
          <aside class="compras-sidebar">
            <div class="compras-sidebar-header">
              <span class="muted">Correos</span>
              <button id="btn-add-email" class="btn-cta btn-icon-only" title="Agregar correo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>
            <div id="compras-emails-list">
              <% if (!emails.length) { %>
                <div class="list-empty">Todavía no hay correos registrados.</div>
              <% } %>
              <% emails.forEach(function(e) { %>
                <div class="compra-email-card" data-id="<%= e.id %>" data-email="<%= e.email %>">
                  <span class="compra-email-text"><%= e.email %></span>
                  <div class="icon-actions-group">
                    <button type="button" class="icon-action btn-edit-email" title="Editar" data-id="<%= e.id %>" data-email="<%= e.email %>">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                      </svg>
                    </button>
                    <button type="button" class="icon-action danger-hover btn-delete-email" title="Eliminar" data-id="<%= e.id %>" data-email="<%= e.email %>">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                      </svg>
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          </aside>

          <section class="compras-panel" id="compras-panel">
            <div class="list-empty">Selecciona un correo a la izquierda para ver su registro de compras.</div>
          </section>
        </div>
      </main>
    </div>
  </div>

  <!-- Modal agregar correo -->
  <div id="modal-add-email" class="modal hidden">
    <form class="card modal-card" id="form-add-email">
      <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <h2>Agregar correo</h2>
      <label>Correo</label>
      <input type="email" id="add-email-field" required placeholder="ej. tucorreo@gmail.com" />
      <div class="row mt">
        <button type="submit" class="primary">Guardar</button>
      </div>
    </form>
  </div>

  <!-- Modal editar correo -->
  <div id="modal-edit-email" class="modal hidden">
    <form class="card modal-card" id="form-edit-email">
      <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <h2>Editar correo</h2>
      <label>Correo</label>
      <input type="email" id="edit-email-field" required />
      <div class="row mt">
        <button type="submit" class="primary">Guardar</button>
      </div>
    </form>
  </div>

  <!-- Modal agregar tarjeta -->
  <div id="modal-add-tarjeta" class="modal hidden">
    <form class="card modal-card" id="form-add-tarjeta">
      <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <h2>Agregar tarjeta</h2>
      <label>Tarjeta</label>
      <input type="text" id="add-tarjeta-field" required placeholder="ej. Visa terminada en 1234" />
      <div class="row mt">
        <button type="submit" class="primary">Guardar</button>
      </div>
    </form>
  </div>

  <!-- Modal editar tarjeta -->
  <div id="modal-edit-tarjeta" class="modal hidden">
    <form class="card modal-card" id="form-edit-tarjeta">
      <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <h2>Editar tarjeta</h2>
      <label>Tarjeta</label>
      <input type="text" id="edit-tarjeta-field" required />
      <div class="row mt">
        <button type="submit" class="primary">Guardar</button>
      </div>
    </form>
  </div>

  <!-- Modal agregar compra -->
  <div id="modal-add-compra" class="modal hidden">
    <form class="card card-xwide modal-card modal-card-flex" id="form-add-compra">
      <div class="modal-card-header">
        <div class="modal-card-header-row">
          <h2 id="modal-add-compra-title">Agregar compra</h2>
          <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="modal-tabs">
          <button type="button" class="modal-tab-btn active" data-tab="detalles">Detalles</button>
          <button type="button" class="modal-tab-btn" data-tab="trackings">Trackings <span class="modal-tab-count" id="compra-trackings-count"></span></button>
        </div>
      </div>

      <div class="modal-card-body">
        <div class="modal-tab-panel" data-tab-panel="detalles">
          <div class="compra-detalles-grid">
            <div class="compra-detalles-fields">
              <label>Tienda</label>
              <div class="row">
                <select id="compra-tienda-select">
                  <option value="">— Elegir tienda —</option>
                  <% tags.forEach(function(t) { %>
                    <option value="<%= t.id %>" data-name="<%= t.name %>"><%= t.name %></option>
                  <% }) %>
                </select>
                <button type="button" class="icon-action" id="btn-toggle-new-tienda" title="Agregar tienda nueva">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="row mt hidden" id="new-compra-tienda-row">
                <input type="text" id="new-compra-tag-name" placeholder="Nueva etiqueta, ej. Depop" />
                <button type="button" id="btn-add-compra-tag">Agregar</button>
              </div>

              <label class="mt">Correo</label>
              <input type="email" id="compra-correo-field" required placeholder="ej. tucorreo@gmail.com" />

              <label class="mt">Tarjeta usada</label>
              <div class="row">
                <select id="compra-tarjeta-select">
                  <option value="">— Elegir tarjeta —</option>
                </select>
                <button type="button" class="icon-action" id="btn-toggle-new-tarjeta" title="Agregar tarjeta nueva">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="row mt hidden" id="new-compra-tarjeta-row">
                <input type="text" id="new-compra-tarjeta-value" placeholder="Nueva tarjeta, ej. Visa terminada en 1234" />
                <button type="button" id="btn-add-compra-tarjeta">Agregar</button>
              </div>

              <label class="mt">Descripción</label>
              <input type="text" id="compra-descripcion-field" placeholder="ej. Amazon Echo" />

              <div id="compra-monto-groups"></div>
              <p class="muted field-hint" id="compra-monto-hint">Elige la tienda arriba para poder poner el gasto.</p>
            </div>

            <div class="compra-detalles-photo">
              <label>Foto del producto</label>
              <div class="compra-imagen-paste" id="compra-imagen-paste" tabindex="0">
                <img id="compra-imagen-preview" class="hidden" alt="Foto del producto" />
                <span class="muted" id="compra-imagen-placeholder">Haz clic aquí y pega una imagen (Ctrl+V)</span>
                <button type="button" class="icon-action danger-hover hidden" id="btn-remove-imagen" title="Quitar imagen">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-tab-panel hidden" data-tab-panel="trackings">
          <div id="compra-trackings-list"></div>
          <button type="button" class="btn-secondary" id="btn-add-tracking">+ Agregar tracking</button>
        </div>
      </div>

      <div class="modal-card-footer">
        <button type="submit" class="primary" id="btn-submit-compra">Guardar compra</button>
      </div>
    </form>
  </div>

  <!-- Modal de información de un producto enviado (solo lectura) -->
  <div id="modal-producto-info" class="modal hidden">
    <div class="card modal-card producto-info-card">
      <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div id="producto-info-content"></div>
    </div>
  </div>

  <!-- Modal de confirmación genérico -->
  <div id="modal-confirm" class="modal hidden">
    <div class="card">
      <p id="confirm-message"></p>
      <div class="row mt">
        <button type="button" class="danger" id="confirm-yes">Sí, eliminar</button>
        <button type="button" id="confirm-no">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Aviso flotante (toast) -->
  <div id="toast" class="toast"></div>

  <script src="/compras.js"></script>
</body>
</html>
