<!DOCTYPE html>
<html lang="es">
<head>
  <title>Emails</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="shell-wrap">
    <div class="app-shell">
      <%- include('partials/sidebar', { activeNav: 'emails' }) %>
      <main class="app-main">
        <header class="topbar">
          <h1>Emails</h1>
          <div class="header-actions">
            <button id="btn-add-secondary-email" class="btn-cta btn-icon-only" title="Agregar correo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>
        </header>

        <p class="muted field-hint">Correos secundarios (no son buzones reales) — se usan como opciones al agregar o editar una compra en Compras.</p>

        <div class="secondary-emails-grid" id="secondary-emails-list">
          <% if (!emails.length) { %>
            <div class="list-empty">Todavía no has agregado ningún correo aquí.</div>
          <% } %>
          <% emails.forEach(function(e) { %>
            <div class="secondary-email-card" data-id="<%= e.id %>" data-email="<%= e.email %>">
              <span class="secondary-email-text"><%= e.email %></span>
              <div class="icon-actions-group">
                <button type="button" class="icon-action btn-edit-secondary-email" title="Editar" data-id="<%= e.id %>" data-email="<%= e.email %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                  </svg>
                </button>
                <button type="button" class="icon-action danger-hover btn-delete-secondary-email" title="Eliminar" data-id="<%= e.id %>" data-email="<%= e.email %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18"></path>
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                  </svg>
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </main>
    </div>
  </div>

  <!-- Modal agregar correo -->
  <div id="modal-add-secondary-email" class="modal hidden">
    <form class="card modal-card" id="form-add-secondary-email">
      <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <h2>Agregar correo</h2>
      <label>Correo</label>
      <input type="email" id="add-secondary-email-field" required placeholder="ej. tucorreo@gmail.com" />
      <div class="row mt">
        <button type="submit" class="primary">Guardar</button>
      </div>
    </form>
  </div>

  <!-- Modal editar correo -->
  <div id="modal-edit-secondary-email" class="modal hidden">
    <form class="card modal-card" id="form-edit-secondary-email">
      <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <h2>Editar correo</h2>
      <label>Correo</label>
      <input type="email" id="edit-secondary-email-field" required />
      <div class="row mt">
        <button type="submit" class="primary">Guardar</button>
      </div>
    </form>
  </div>

  <!-- Modal de confirmación genérico -->
  <div id="modal-confirm" class="modal hidden">
    <div class="card">
      <p id="confirm-message"></p>
      <div class="row mt">
        <button type="button" class="danger" id="confirm-yes">Sí, eliminar</button>
        <button type="button" id="confirm-no">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Aviso flotante (toast) -->
  <div id="toast" class="toast"></div>

  <script src="/emails.js"></script>
</body>
</html>
