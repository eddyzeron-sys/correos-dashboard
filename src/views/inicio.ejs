<!DOCTYPE html>
<html lang="es">
<head>
  <title>Dashboard</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="shell-wrap">
    <div class="app-shell">
      <%- include('partials/sidebar', { activeNav: 'inicio' }) %>
      <main class="app-main">
        <header class="topbar">
          <h1>Dashboard</h1>
        </header>

        <div class="inicio-grid">
          <% if (!user.hide_correos) { %>
            <a class="inicio-card" href="/dashboard">
              <span class="inicio-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="M3 7l9 6 9-6"></path>
                </svg>
              </span>
              <span class="inicio-card-title">Correos</span>
              <span class="inicio-card-desc">Crear y administrar cuentas de correo</span>
            </a>
          <% } %>

          <% if (!user.hide_trackings) { %>
            <a class="inicio-card" href="/trackings">
              <span class="inicio-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16.5 9.4 7.55 4.24"></path>
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
              </span>
              <span class="inicio-card-title">Trackings</span>
              <span class="inicio-card-desc">Envíos detectados automáticamente</span>
            </a>
          <% } %>

          <% if (!user.hide_compras) { %>
            <a class="inicio-card" href="/compras">
              <span class="inicio-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                  <path d="M3 6h18"></path>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
              </span>
              <span class="inicio-card-title">Compras</span>
              <span class="inicio-card-desc">Registro de compras online</span>
            </a>
          <% } %>

          <% if (!user.hide_emails) { %>
            <a class="inicio-card" href="/emails">
              <span class="inicio-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path>
                </svg>
              </span>
              <span class="inicio-card-title">Emails</span>
              <span class="inicio-card-desc">Libreta de correos secundarios</span>
            </a>
          <% } %>

          <% if (user.role === 'admin') { %>
            <a class="inicio-card" href="/admin/users">
              <span class="inicio-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </span>
              <span class="inicio-card-title">Usuarios</span>
              <span class="inicio-card-desc">Aprobar y administrar cuentas</span>
            </a>

            <a class="inicio-card" href="/setup">
              <span class="inicio-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="7" rx="1.6"></rect>
                  <rect x="2" y="14" width="20" height="7" rx="1.6"></rect>
                  <circle cx="6.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
                  <circle cx="6.5" cy="17.5" r="1" fill="currentColor" stroke="none"></circle>
                </svg>
              </span>
              <span class="inicio-card-title">Servidor Mailcow</span>
              <span class="inicio-card-desc">Conexión al servidor de correo</span>
            </a>
          <% } %>

          <a class="inicio-card" href="/configuracion">
            <span class="inicio-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </span>
            <span class="inicio-card-title">Configuración</span>
            <span class="inicio-card-desc">Elegir qué menús se muestran</span>
          </a>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
