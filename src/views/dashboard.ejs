<!DOCTYPE html>
<html lang="es">
<head>
  <title>Dashboard de Correos</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="shell-wrap">
    <div class="app-shell">
      <%- include('partials/sidebar', { activeNav: 'dashboard' }) %>
      <main class="app-main">
        <header class="topbar">
          <div class="list-toolbar">
            <input type="text" id="email-search" class="toolbar-search" placeholder="Buscar correo..." />
            <select id="email-filter" class="toolbar-filter">
              <option value="all">Todos</option>
              <option value="new">Correos nuevos primero</option>
              <option value="recent">Más recientes</option>
              <option value="az">A-Z</option>
            </select>
            <button type="button" id="btn-reset-filter" class="icon-action" title="Quitar filtro">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="header-actions">
            <button id="btn-refresh" class="btn-secondary btn-icon-only" title="Buscar correos nuevos en todos los buzones">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 4v6h-6"></path>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
              </svg>
            </button>
            <button id="btn-add" class="btn-cta btn-icon-only" title="Agregar correo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>
        </header>

        <% if (error) { %>
          <p class="error"><%= error %></p>
        <% } %>

        <div class="list">
          <% if (!emails.length) { %>
            <div class="list-empty">Todavía no hay correos creados desde aquí.</div>
          <% } %>
          <% emails.forEach(function(e) { %>
            <div class="email-row" data-email="<%= e.email %>" data-created="<%= e.created_at %>">
              <div class="email-top-row">
                <a href="/inbox/<%= e.id %>" class="email-address"><%= e.email %></a>
                <button type="button" class="icon-action btn-copy" title="Copiar correo" data-email="<%= e.email %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                </button>
                <a href="/inbox/<%= e.id %>" class="new-mail-badge hidden" id="new-badge-<%= e.id %>">
                  <span class="dot"></span><span class="count"></span> nuevo(s)
                </a>
              </div>
              <div class="email-bottom-row">
                <div class="email-tags">
                  <% e.tags.forEach(function(t) { %>
                    <span class="tag-pill" style="background: <%= t.color %>"><%= t.name %></span>
                  <% }) %>
                </div>
                <div class="icon-actions-group">
                  <a href="/inbox/<%= e.id %>" class="icon-action" title="Ver bandeja">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </a>
                  <button type="button" class="icon-action btn-edit" title="Editar"
                          data-id="<%= e.id %>" data-email="<%= e.email %>"
                          data-tag-colors="<%= JSON.stringify(Object.fromEntries(e.tags.map(function(t){ return [t.id, t.color]; }))) %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                    </svg>
                  </button>
                  <form method="POST" action="/email-accounts/<%= e.id %>/delete" class="inline form-confirm"
                        data-confirm-message="¿Eliminar <%= e.email %>? Esto borra el buzón en Mailcow también.">
                    <button type="submit" class="icon-action danger-hover" title="Eliminar">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                      </svg>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </main>
    </div>
  </div>

  <!-- Modal agregar -->
  <div id="modal-add" class="modal hidden">
    <form class="card card-wide modal-card" method="POST" action="/email-accounts">
      <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <h2>Agregar correo</h2>

      <label>Nombre del correo</label>
      <div class="row">
        <input type="text" name="local_part" id="local-part-field" required placeholder="ej. juanperez" />
        <button type="button" id="btn-random-name">🎲 Aleatorio</button>
      </div>
      <p class="muted field-hint">Se va a crear como <strong>@<%= domain %></strong> — las etiquetas se agregan después, editando el correo.</p>

      <div class="row mt">
        <button type="submit" class="primary">Crear</button>
      </div>
    </form>
  </div>

  <!-- Modal editar -->
  <div id="modal-edit" class="modal hidden">
    <div class="card card-wide modal-card">
      <button type="button" class="icon-action modal-close-btn btn-cancel" title="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <h2>Editar <span id="edit-email-label"></span></h2>

      <div id="form-edit-tags">
        <label>Etiquetas <span class="muted">(clic en un color para aplicarla a este correo)</span></label>
        <div class="tag-checklist" id="edit-tag-checklist">
          <% tags.forEach(function(t) { %>
            <div class="tag-card" data-tag-id="<%= t.id %>">
              <span class="tag-card-name"><%= t.name %></span>
              <div class="tag-card-actions">
                <button type="button" class="tag-card-btn color-dot-btn" data-color="#16a34a" title="Verde en este correo" style="background:#16a34a"></button>
                <button type="button" class="tag-card-btn color-dot-btn" data-color="#dc2626" title="Rojo en este correo" style="background:#dc2626"></button>
                <button type="button" class="tag-card-btn tag-remove-btn" data-tag-id="<%= t.id %>" data-tag-name="<%= t.name %>" title="Quitar de este correo">✕</button>
              </div>
            </div>
          <% }) %>
        </div>
        <% if (!tags.length) { %><p class="tag-check-empty" id="edit-tag-empty-msg">No tienes etiquetas todavía.</p><% } %>

        <label class="mt">Nueva etiqueta</label>
        <div class="row">
          <input type="text" id="new-tag-name" placeholder="ej. eBay" />
          <div class="tag-card-actions" id="new-tag-color-picker">
            <button type="button" class="tag-card-btn color-dot-btn" data-color="#16a34a" title="Crear en verde" style="background:#16a34a"></button>
            <button type="button" class="tag-card-btn color-dot-btn" data-color="#dc2626" title="Crear en rojo" style="background:#dc2626"></button>
          </div>
        </div>
        <p class="muted field-hint">Escribe el nombre y da clic en el color para crearla y aplicarla aquí.</p>
      </div>
    </div>
  </div>

  <!-- Modal de confirmación genérico -->
  <div id="modal-confirm" class="modal hidden">
    <div class="card">
      <p id="confirm-message"></p>
      <div class="row mt">
        <button type="button" class="danger" id="confirm-yes">Sí, eliminar</button>
        <button type="button" id="confirm-no">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Aviso flotante (toast) -->
  <div id="toast" class="toast"></div>

  <script src="/dashboard.js"></script>
</body>
</html>
