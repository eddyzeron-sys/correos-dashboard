<!DOCTYPE html>
<html lang="es">
<head>
  <title>Registrarse</title>
  <%- include('partials/head') %>
</head>
<body class="centered">
  <% if (success) { %>
    <div class="card">
      <div class="logo-dot" style="margin: 0 0 16px;">C</div>
      <h1>Registro recibido</h1>
      <p>Tu cuenta fue creada y está <strong>pendiente de aprobación</strong> por un administrador.
         Te podrás loguear una vez que la activen.</p>
      <p class="mt"><a href="/login">Volver al login</a></p>
    </div>
  <% } else { %>
    <form class="card" method="POST" action="/register">
      <div class="logo-dot" style="margin: 0 0 16px;">C</div>
      <h1>Crear cuenta</h1>
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
      <label>Usuario</label>
      <input type="text" name="username" required autofocus />
      <label>Contraseña (mínimo 8 caracteres)</label>
      <input type="password" name="password" required minlength="8" />
      <label>Confirmar contraseña</label>
      <input type="password" name="password2" required minlength="8" />
      <button type="submit" class="primary">Registrarme</button>
      <p class="mt muted">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </form>
  <% } %>
</body>
</html>
